{
  "schema": "App-binding-template-not-native-pipeline",
  "executable": false,
  "ready_for_launch": false,
  "blocking_reason": "New A/B images, prompt, task ID and output directory are not bound. OnlyApp may materialize a fresh task.",
  "pipeline": {
    "id": "<FRESH_APP_S41_AB_ATTEMPT_ID>",
    "stages": [
      {
        "id": "model-select",
        "type": "model-select",
        "iports": [],
        "config": {
          "hf_dir": "local/MiniMax-H3-FL2VA-8bit"
        }
      },
      {
        "id": "load-A",
        "type": "load-image",
        "iports": [],
        "config": {
          "url": [
            "<NEW_REVIEWED_IMAGE_A_PATH>"
          ]
        }
      },
      {
        "id": "normalize-A",
        "type": "image-resample",
        "iports": [
          {
            "src": "load-A",
            "oport": 0
          }
        ],
        "config": {
          "width": 768,
          "height": 448,
          "fit": "crop",
          "algorithm": "lanczos"
        }
      },
      {
        "id": "vae-encode-A",
        "type": "vae-encode",
        "iports": [
          {
            "src": "normalize-A",
            "oport": 0
          },
          {
            "src": "model-select",
            "oport": 0
          }
        ],
        "config": {
          "unload_when_idle": "always"
        }
      },
      {
        "id": "load-B",
        "type": "load-image",
        "iports": [],
        "config": {
          "url": [
            "<NEW_REVIEWED_IMAGE_B_PATH>"
          ]
        }
      },
      {
        "id": "normalize-B",
        "type": "image-resample",
        "iports": [
          {
            "src": "load-B",
            "oport": 0
          }
        ],
        "config": {
          "width": 768,
          "height": 448,
          "fit": "crop",
          "algorithm": "lanczos"
        }
      },
      {
        "id": "vae-encode-B",
        "type": "vae-encode",
        "iports": [
          {
            "src": "normalize-B",
            "oport": 0
          },
          {
            "src": "model-select",
            "oport": 0
          }
        ],
        "config": {
          "unload_when_idle": "always"
        }
      },
      {
        "id": "text-prompt",
        "type": "text-prompt",
        "iports": [],
        "config": {
          "text": "<REVIEWED_BOUND_S41_A_B_PROMPT>"
        }
      },
      {
        "id": "diffusion-conditioner",
        "type": "diffusion-conditioner",
        "iports": [
          {
            "src": "text-prompt",
            "oport": 0
          },
          {
            "src": "",
            "oport": 0
          },
          {
            "src": "model-select",
            "oport": 0
          }
        ],
        "config": {
          "unload_when_idle": "always"
        }
      },
      {
        "id": "minimax-h3-model-config",
        "type": "minimax-h3-model-config",
        "iports": [],
        "config": {
          "video_shift": 12,
          "audio_shift": 3,
          "condition_timestep": 1,
          "audio_seconds": 0,
          "lora": "larryvrh/MiniMax-H3-Turbo-Lora-v4-600-ema",
          "lora_scale": 1
        }
      },
      {
        "id": "generate-video",
        "type": "generate-video",
        "iports": [
          {
            "src": "diffusion-conditioner",
            "oport": 0
          },
          {
            "src": "",
            "oport": 0
          },
          {
            "src": "model-select",
            "oport": 0
          },
          {
            "src": "",
            "oport": 0
          },
          {
            "src": "",
            "oport": 0
          },
          {
            "src": "vae-encode-A",
            "oport": 0
          },
          {
            "src": "vae-encode-B",
            "oport": 0
          },
          {
            "src": "",
            "oport": 0
          },
          {
            "src": "",
            "oport": 0
          },
          {
            "src": "minimax-h3-model-config",
            "oport": 0
          }
        ],
        "config": {
          "height": 448,
          "width": 768,
          "frames": 73,
          "fps": 24,
          "steps": 4,
          "seed": 841041,
          "i8_gemm": false,
          "unload_when_idle": "always"
        }
      },
      {
        "id": "vae-decode",
        "type": "vae-decode",
        "iports": [
          {
            "src": "generate-video",
            "oport": 0
          },
          {
            "src": "model-select",
            "oport": 0
          }
        ],
        "config": {}
      },
      {
        "id": "audio-vae-decode",
        "type": "audio-vae-decode",
        "iports": [
          {
            "src": "generate-video",
            "oport": 1
          },
          {
            "src": "model-select",
            "oport": 0
          }
        ],
        "config": {}
      },
      {
        "id": "rgb-to-video",
        "type": "rgb-to-video",
        "iports": [
          {
            "src": "vae-decode",
            "oport": 0
          }
        ],
        "config": {
          "fps": 24
        }
      },
      {
        "id": "save-video",
        "type": "save-video",
        "iports": [
          {
            "src": "rgb-to-video",
            "oport": 0
          },
          {
            "src": "audio-vae-decode",
            "oport": 0
          }
        ],
        "config": {
          "output_url": "<FRESH_APP_OUTPUT_DIRECTORY>/S41-AB-native-73frames.mp4",
          "enable_video": true,
          "enable_audio": true
        }
      },
      {
        "id": "save-detail-frames",
        "type": "save-image",
        "iports": [
          {
            "src": "vae-decode",
            "oport": 0
          }
        ],
        "config": {
          "path": "<FRESH_APP_OUTPUT_DIRECTORY>/record/lossless-frames/frame-%04d.png",
          "format": "png",
          "compression": 1
        }
      },
      {
        "id": "save-detail-source",
        "type": "save-image",
        "iports": [
          {
            "src": "normalize-A",
            "oport": 0
          }
        ],
        "config": {
          "path": "<FRESH_APP_OUTPUT_DIRECTORY>/record/source-A-resized.png",
          "format": "png",
          "compression": 1
        }
      },
      {
        "id": "save-detail-source-B",
        "type": "save-image",
        "iports": [
          {
            "src": "normalize-B",
            "oport": 0
          }
        ],
        "config": {
          "path": "<FRESH_APP_OUTPUT_DIRECTORY>/record/source-B-resized.png",
          "format": "png",
          "compression": 1
        }
      }
    ],
    "subpipelines": []
  }
}
